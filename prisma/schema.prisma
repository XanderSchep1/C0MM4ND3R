// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models (required shape for @auth/prisma-adapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // scrypt hash ("salt:hash", both hex) for email+password accounts. Null for
  // legacy accounts created before password sign-up existed.
  passwordHash  String?
  // scrypt hash of the one-time recovery code used to reset a forgotten
  // password (no email needed). Null until a code has been generated.
  recoveryCodeHash String?
  // Random token in this person's "friend link". Whoever opens the link and accepts becomes their friend;
  // making a new one cancels the old link. Null until they first open the Friends page.
  friendCode String? @unique

  accounts Account[]
  sessions Session[]
  decks    Deck[]
  ownedCards OwnedCard[]
  // Friendships are stored once per pair; see Friendship.
  friendshipsA Friendship[] @relation("FriendshipA")
  friendshipsB Friendship[] @relation("FriendshipB")
  // Decks other people have invited this person to.
  collaborations DeckCollaborator[]
  // Cards this person suggested on someone else's deck.
  suggestedCards DeckCard[] @relation("DeckCardAddedBy")
}

// Two people who are friends. One row per pair, with userAId always the smaller id, so the same
// pair can never be stored twice.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

// A friend the deck's owner invited to the deck. A "contributor" can see the deck and suggest cards
// (they land in the Maybeboard); the owner decides what goes in the main deck.
model DeckCollaborator {
  id        String   @id @default(cuid())
  deckId    String
  userId    String
  role      String   @default("contributor")
  createdAt DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deckId, userId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

// Cards a user says they own, so decks can show what still has to be bought.
// nameKey is the lowercased name used for matching; name keeps the original.
model OwnedCard {
  id       String @id @default(cuid())
  userId   String
  name     String
  nameKey  String
  quantity Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nameKey])
  @@index([userId])
}

model Deck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  format      String   @default("commander")
  description String?
  // When true, /share/[id] renders a read-only view with no auth required.
  // The id itself (a cuid) is the unguessable share token — no separate slug.
  public      Boolean  @default(false)
  // Scryfall set codes whose upgrade suggestions the owner has already
  // reviewed for this deck — anything newer counts as a "new set" badge.
  upgradesSeenSets String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards DeckCard[]
  collaborators DeckCollaborator[]
}

// zone: "commander" | "mainboard" | "maybeboard"
model DeckCard {
  id         String   @id @default(cuid())
  deckId     String
  scryfallId String
  name       String
  quantity   Int      @default(1)
  zone       String   @default("mainboard")
  // The owner's own highlight for this line: "owned" (yellow), "missing" (red) or null.
  mark       String?
  // Who suggested this card. Null for the deck owner's own cards. A friend's suggestion sits in the
  // Maybeboard until the owner accepts it (which clears this) or dismisses it.
  addedById  String?
  addedAt    DateTime @default(now())

  deck    Deck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  addedBy User? @relation("DeckCardAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([deckId, scryfallId, zone])
  @@index([deckId])
}

// Which cards a Scryfall search returned, keyed by a hash of the query and
// options, so repeat searches (suggestions, synergies, upgrades, lands) are
// answered from our own database instead of hitting Scryfall again.
model SearchCache {
  key        String   @id
  cardIds    String[]
  hasMore    Boolean  @default(false)
  totalCards Int?
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

// Fixed-window counters for rate limiting sign-in and sign-up, shared across
// all serverless instances because they live in the database.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())
}

// Local cache of Scryfall card JSON, refreshed lazily. Keeps us within
// Scryfall's rate limits and their "cache for at least 24h" guidance.
model CardCache {
  scryfallId String   @id
  name       String
  data       Json
  updatedAt  DateTime @updatedAt

  @@index([name])
}

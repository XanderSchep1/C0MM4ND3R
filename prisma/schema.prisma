// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models (required shape for @auth/prisma-adapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // scrypt hash ("salt:hash", both hex) for email+password accounts. Null for
  // legacy accounts created before password sign-up existed.
  passwordHash  String?

  accounts Account[]
  sessions Session[]
  decks    Deck[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Deck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  format      String   @default("commander")
  description String?
  // When true, /share/[id] renders a read-only view with no auth required.
  // The id itself (a cuid) is the unguessable share token — no separate slug.
  public      Boolean  @default(false)
  // Scryfall set codes whose upgrade suggestions the owner has already
  // reviewed for this deck — anything newer counts as a "new set" badge.
  upgradesSeenSets String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards DeckCard[]
}

// zone: "commander" | "mainboard" | "maybeboard"
model DeckCard {
  id         String   @id @default(cuid())
  deckId     String
  scryfallId String
  name       String
  quantity   Int      @default(1)
  zone       String   @default("mainboard")
  addedAt    DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, scryfallId, zone])
  @@index([deckId])
}

// Which cards a Scryfall search returned, keyed by a hash of the query and
// options, so repeat searches (suggestions, synergies, upgrades, lands) are
// answered from our own database instead of hitting Scryfall again.
model SearchCache {
  key        String   @id
  cardIds    String[]
  hasMore    Boolean  @default(false)
  totalCards Int?
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

// Fixed-window counters for rate limiting sign-in and sign-up, shared across
// all serverless instances because they live in the database.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())
}

// Local cache of Scryfall card JSON, refreshed lazily. Keeps us within
// Scryfall's rate limits and their "cache for at least 24h" guidance.
model CardCache {
  scryfallId String   @id
  name       String
  data       Json
  updatedAt  DateTime @updatedAt

  @@index([name])
}
